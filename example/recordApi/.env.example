# Environment variables used by the on-demand recording API examples.
# Copy to .env and fill in (never commit .env).
#
# Target service URL (default https://record.pp-cdn.org)
RECORD_API_BASE_URL=https://record.pp-cdn.org
# appId created in the console and its own appSecret (split-rec verifies with it)
RECORD_API_APP_ID=app_xxxxxxxxxxxx
RECORD_API_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# test_record_api.py live cases also accept these names (same as the main repo
# integrationTest/api):
# PPCDN_TEST_APP_ID=app_xxxxxxxxxxxx
# PPCDN_TEST_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PPCDN_RECORD_BASE_URL=https://record.pp-cdn.org
# RECORD_API_TEST_TABLE=table

# local_e2e.py needs:
# MMX_BIN=D:\path\to\mmx.exe
# FFMPEG_BIN=D:\path\to\ffmpeg.exe
