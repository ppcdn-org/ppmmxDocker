# Copy to .env and fill in before `docker compose up -d`.
# See README.md for the full walkthrough.

# ── Required: from the console's "ppmmx" tab → Add a ppmmx node ──
# Both are shown once on create (and always viewable/copyable afterwards).
MMX_NODE_SECRET=
MMX_LICENSE_CODE=

# ── Node role: standalone | origin | edge | record ────────────────
# Must match the type you picked in the console when creating the node.
MMX_ROLE=standalone

# ── PPCDN control plane ───────────────────────────────────────────
# The console shows the right value for your account's region/cluster.
MMX_CONTROL_URL=wss://api.pp-cdn.org/ws/mmx

# ── Deployment-specific overrides ─────────────────────────────────
# Free-text label shown in ppcenter/console, no functional effect.
MMX_NODE_REGION=self-hosted
# Max concurrent publish+play channels this node accepts.
MMX_NODE_CAPACITY=100
# REQUIRED for standalone/origin/edge: this host's public IP or domain, as
# viewers/publishers will reach it (http://, or https:// behind your own TLS
# terminator). Leave the port off - it's always :8888 inside the container,
# mapped to MMX_WEBRTC_PORT below.
MMX_WEBRTC_BASE_URL=http://CHANGE_ME:8888
# origin only: where ppcenter tells registered publisher nodes to push to.
# Leave blank unless you know you need it (see conf/origin.yml's comment).
MMX_PUBLISH_URL=

# ── Host port mapping ──────────────────────────────────────────────
# Change the left side only if running more than one ppmmx container on the
# same host (e.g. 8888:8888 for node 1, 8898:8888 for node 2, ...).
MMX_WEBRTC_PORT=8888
MMX_WEBRTC_UDP_PORT=8188
MMX_ADMIN_PORT=8080
MMX_API_PORT=9996
MMX_SRT_PORT=7890
